int getMaxValueForKnapsack(vector<int>&W, vector<int>&V, int maxWeight){
    int n=W.size();
    int maxValue = accumulate(V.begin(), V.end(),0ll); // V<-[0,1000], n<-[1,100] so maxValue<-[0,1e5]

    vector<vector<int>>dp(n, vector<int>(maxValue+1, INT_MAX)); // dp[i][j]= minimum weight upto ith element and total value of j
    for(int i=0;i<n;i++) dp[i][0]=0;
    dp[0][V[0]]=W[0];
    long long ans=W[0]<=maxWeight ? V[0] : 0;
    for(int i=1;i<n;i++){
        for(int j=1;j<=maxValue;j++){
            dp[i][j]=dp[i-1][j]; // in case ith object is not  picked
            if(j>=V[i]) dp[i][j]=min(dp[i][j], dp[i-1][j-V[i]]+W[i]); // if ith object is picked
            if(dp[i][j]<=maxWeight) ans=max(ans,j);
        }
    }

    return ans;
}
void solve(){
    int n,k, maxWeight;
    cin>>n>>maxWeight;
    vector<int>W(n);
    vector<int>V(n);
    for(int i=0;i<n;i++) cin>>W[i]>>V[i];
    cout<<getMaxValueForKnapsack(W,V,maxWeight)<<"\n";
}

